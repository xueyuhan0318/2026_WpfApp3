<Window x:Class="_2026_WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_WpfApp3"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="WPF小畫家ver2" Height="450" Width="800">
    <DockPanel>
        <Menu Height="30" DockPanel.Dock="Top">
            <MenuItem Header="檔案" Height="30" VerticalAlignment="Center" FontSize="16">
                <MenuItem Header="開啟新畫布" VerticalAlignment="Center" FontSize="16"></MenuItem>
                <MenuItem Header="儲存畫布" VerticalAlignment="Center" FontSize="16"></MenuItem>
            </MenuItem> 
        </Menu>
        <ToolBarTray Height="40" Background="LightCyan" DockPanel.Dock="Top">
            <ToolBar Height="40" Width="600" Background="#FF96F3F3">
                <Label Content="筆刷色彩" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" HorizontalAlignment="Center"/>
                <xctk:ColorPicker x:Name="StrokerColorPicker" Width="100" Height="30" SelectedColorChanged="StrokerColorPicker_SelectedColorChanged" DisplayColorAndName="True"/>
                <Label Content="填滿色彩" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <xctk:ColorPicker x:Name="FillColorPicker" Width="100" Height="30" SelectedColorChanged="FillColorPicker_SelectedColorChanged" DisplayColorAndName="True"/>
                <Slider x:Name="ThicknessSlider" Width="120" Minimum="1" Maximum="10" Margin="30,10,0,0" IsSnapToTickEnabled="True" VerticalAlignment="Top"  HorizontalAlignment="Center" ValueChanged="ThicknessSlider_ValueChanged"></Slider>
                <Label FontSize="14" FontWeight="Bold" Margin="30,0,0,0" Content="{Binding Value, ElementName=ThicknessSlider}" Foreground="#FFED1111" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </ToolBar>
            <ToolBar Height="38" Width="600" Background="#FFA8D684">
                <RadioButton x:Name="Line" Height="35" Width="35" Checked="ShapeButton_Checked" FontSize="16" FontWeight="Bold" Tag="Line">
                    <Image Source="/line.png"></Image>
                </RadioButton>
                <RadioButton x:Name="Rectangle" Height="35" Width="35" Checked="ShapeButton_Checked" FontSize="16" FontWeight="Bold" Tag="Rectangle">
                    <Image Source="/rectangle.png"></Image>
                </RadioButton>
                <RadioButton x:Name="Ellipse" Height="35" Width="35" Checked="ShapeButton_Checked" FontSize="16" FontWeight="Bold" Tag="Ellipse">
                    <Image Source="/ellipse.png"></Image>
                </RadioButton>
                <RadioButton x:Name="Polyline" Height="35" Width="35" Checked="ShapeButton_Checked" FontSize="16" FontWeight="Bold" Tag="Polyline">
                    <Image Source="/polyline.png"></Image>
                </RadioButton>
                <Separator/>
                <Button x:Name="EraserButton" Width="35" Height="35" Tag="Eraser" Click="EraserButton_Click">
                    <Image Source="/eraser.png" Cursor="Hand"/>
                </Button>
                <Button x:Name="ClearButton" Width="35" Height="35" Tag="Eraser" Click="ClearButton_Click">
                    <Image Source="/trashcan.png"></Image>
                </Button>
            </ToolBar>
        </ToolBarTray>
        <StatusBar Height="35" Background="LightGray" DockPanel.Dock="Bottom">
            <StatusBarItem Width="200">
                <Label x:Name="StatusLabel" Content="Ready" FontSize="14" VerticalAlignment="Center" Width="150"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem Width="200">
                <Label x:Name="ShapeLabel" Content="形狀" FontSize="14" VerticalAlignment="Center" Width="150"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <Label x:Name="ColorLabel" Content="色彩" FontSize="14" VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>
        <Canvas x:Name="MyCanvas" Background="#FFF5f5E7" MouseEnter="MyCanvas_MouseEnter" MouseLeftButtonDown="MyCanvas_MouseLeftButtonDown" MouseMove="MyCanvas_MouseMove" MouseLeftButtonUp="MyCanvas_MouseLeftButtonUp"/>

    </DockPanel>
</Window>
